# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for generated answers. Create one at https://openrouter.ai/keys
# Without it the app still runs and returns retrieved passages (degraded mode).
OPENROUTER_API_KEY=

# Ordered fallback chain of OpenRouter models, tried left to right.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free

# Protects /api/admin/* when set. Leave empty for local development.
ADMIN_TOKEN=

# Optional tuning
# MIN_RELEVANCE=0.62
# RATE_LIMIT_PER_MINUTE=12
# LOG_LEVEL=INFO
